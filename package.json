{
  "name": "git-plugin-vc",
  "publisher": "NGdust",
  "displayName": "Git Panel",
  "description": "Simple UI for managing git of the current project in the bottom panel of VS Code",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/NGdust/git-panel"
  },
  "homepage": "https://github.com/NGdust/git-panel",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "SCM",
    "Other"
  ],
  "activationEvents": [
    "onView:gitPanelView",
    "onCommand:gitPanel.refresh"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "gitPanel",
          "title": "Git Panel",
          "icon": "media/git-panel.svg"
        }
      ]
    },
    "views": {
      "gitPanel": [
        {
          "id": "gitPanelView",
          "name": "Git Panel",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "gitPanel.refresh",
        "title": "Git Panel: Обновить данные"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext .ts",
    "prepare": "npx simple-git-hooks",
    "package": "vsce package",
    "dev:install": "npm run build && npx vsce package --allow-missing-repository && (command -v cursor >/dev/null 2>&1 && cursor --install-extension $(ls -t *.vsix | head -n 1) || command -v code >/dev/null 2>&1 && code --install-extension $(ls -t *.vsix | head -n 1))",
    "test": "echo \"No tests yet\""
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "@vscode/vsce": "^2.22.0",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.3.3",
    "simple-git-hooks": "^2.11.1",
    "typescript": "^5.6.3"
  }
}




